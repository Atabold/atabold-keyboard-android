<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- kbfr fork: renamed so this app is not mistaken for the original FUTO Keyboard. The payment
         screens keep saying "FUTO Keyboard": they refer to FUTO's own product (strings-payment-app.xml,
         strings-uix.xml) and stay untouched. "Clavier Atabold" is the name in every language: the build
         leaves out FUTO's translations of this file (build.gradle, translationsWithoutEngValues). -->

    <!-- Application name for the keyboard. -->
    <string name="english_ime_name">Clavier Atabold</string>

    <!-- Name of Android spell checker service. -->
    <string name="spell_checker_service_name">Atabold Spell Checker</string>

    <!-- Title for Android Keyboard settings screen. -->
    <string name="english_ime_settings">Clavier Atabold</string>

    <!-- Title for the spell checking service settings screen. -->
    <string name="android_spell_checker_settings">Atabold Spell Checker Settings</string>
</resources>
